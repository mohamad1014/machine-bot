{
  "displayName": "Testing Agent",
  "id": "testing_agent",
  "description": "Agent dedicated to locating and summarizing approved docling research documents for testing workflows.",
  "handover": [],
  "tools": [
    {
      "name": "DoclingDocumentSearchTool",
      "config": {
        "index_env_var": "TESTING_AGENT_SEARCH_INDEX"
      }
    },
    {
      "name": "DoclingDocumentContentTool",
      "config": {
        "container_env_var": "CosmosTestDocumentsContainer"
      }
    }
  ],
  "model": "gpt-4.1",
  "logging": {
    "enabled": true,
    "level": "INFO",
    "save_to_blob": false
  }
}
